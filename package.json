{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint app.js",
    "format": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint",
      "prettier --check"
    ],
    "*.{html,css,json,md}": [
      "prettier --check"
    ]
  }
}
